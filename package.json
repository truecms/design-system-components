{
  "name": "auds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/truecms/design-system-components"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.3.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "express": "^5.2.1",
    "inquirer": "^12.10.0",
    "jest": "^30.3.0",
    "pa11y": "^9.1.1",
    "postcss": "^8.5.10",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.42.0",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "semver": "^7.7.3",
    "treeify": "^1.1.0",
    "vite": "^6.4.2"
  },
  "scripts": {
    "scaffolding": "node ./scripts/helper.js scaffolding",
    "bootstrap": "pnpm install --frozen-lockfile",
    "build": "pnpm -r run build",
    "pack:tarballs": "node scripts/pack-workspace-tarballs.js",
    "changeset": "changeset",
    "prepare:version": "changeset version",
    "release": "changeset publish",
    "publish": "pnpm run release",
    "nuke": "pnpm run delete:node_modules && pnpm run delete:lib",
    "delete:node_modules": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "delete:lib": "rimraf packages/*/lib",
    "test:unit-test": "jest --runInBand",
    "test": "pnpm run test:unit-test && node scripts/helper.js test && node ./scripts/a11y.js",
    "build:site-dist": "node scripts/build-site-dist.js",
    "test:design-system": "jest --runInBand --config jest.integration.config.cjs",
    "test:bundle-size": "node scripts/metrics/compare-bundle-size.mjs --baseline reports/bundles-baseline.json --unified reports/bundles-unified.json --cap 0.3",
    "test:migrations": "jest --runInBand --config jest.integration.config.cjs --runTestsByPath tests/integration/migration.smoke.test.ts tests/integration/drupal/unified-migration.test.ts tests/integration/react/unified-migration.test.ts tests/integration/build/unified-build-output.test.ts tests/integration/build/unified-prepublish.test.ts",
    "build:unified": "vite build --config vite.config.ts",
    "test:unified": "pnpm run test:migrations && pnpm run test:bundle-size",
    "publish:unified": "echo \"Publishing unified package via Changesets is handled by the standard release workflow\""
  },
  "jest": {
    "testRegex": "\\.spec.js$",
    "collectCoverageFrom": [
      "packages/*/lib/js/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.2",
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.12": "1.1.14",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild": "^0.25.0",
      "fast-uri@<=3.1.1": "3.1.2",
      "follow-redirects@1.15.11": "1.16.0",
      "immutable@3.8.2": "3.8.3",
      "ip-address@<=10.1.0": "10.2.0",
      "lodash@4.17.21": "4.18.0",
      "minimatch@3.1.2": "3.1.5",
      "picomatch@2.3.1": "2.3.2",
      "postcss@^8.0.0 <8.5.10": "8.5.13",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "react-router@7.9.5": "7.14.2",
      "serialize-javascript@6.0.2": "7.0.5",
      "socket.io-parser@4.2.4": "4.2.6",
      "ws@>=8.0.0 <8.20.1": "8.21.0",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": "7.29.7",
      "basic-ftp@<=5.3.0": "5.3.1"
    }
  }
}
