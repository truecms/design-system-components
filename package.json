{
  "name": "auds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/truecms/design-system-components"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "express": "^5.3.0",
    "inquirer": "^12.11.1",
    "jest": "^30.5.2",
    "pa11y": "^10.0.0",
    "postcss": "^8.5.23",
    "prop-types": "^15.8.1",
    "puppeteer": "^25.16.0",
    "rimraf": "^6.1.4",
    "sass": "^1.107.1",
    "semver": "^7.8.6",
    "treeify": "^1.1.0",
    "vite": "^6.4.4"
  },
  "scripts": {
    "scaffolding": "node ./scripts/helper.js scaffolding",
    "bootstrap": "pnpm install --frozen-lockfile",
    "build": "pnpm -r run build",
    "pack:tarballs": "node scripts/pack-workspace-tarballs.js",
    "changeset": "changeset",
    "prepare:version": "changeset version",
    "release": "changeset publish",
    "publish": "pnpm run release",
    "nuke": "pnpm run delete:node_modules && pnpm run delete:lib",
    "delete:node_modules": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "delete:lib": "rimraf packages/*/lib",
    "test:unit-test": "jest --runInBand",
    "test": "pnpm run test:unit-test && node scripts/helper.js test && node ./scripts/a11y.js",
    "build:site-dist": "node scripts/build-site-dist.js",
    "test:design-system": "jest --runInBand --config jest.integration.config.cjs",
    "test:bundle-size": "node scripts/metrics/compare-bundle-size.mjs --baseline reports/bundles-baseline.json --unified reports/bundles-unified.json --cap 0.3",
    "test:migrations": "jest --runInBand --config jest.integration.config.cjs --runTestsByPath tests/integration/migration.smoke.test.ts tests/integration/drupal/unified-migration.test.ts tests/integration/react/unified-migration.test.ts tests/integration/build/unified-build-output.test.ts tests/integration/build/unified-prepublish.test.ts",
    "build:unified": "vite build --config vite.config.mts",
    "test:unified": "pnpm run test:migrations && pnpm run test:bundle-size",
    "publish:unified": "echo \"Publishing unified package via Changesets is handled by the standard release workflow\""
  },
  "jest": {
    "testRegex": "\\.spec.js$",
    "collectCoverageFrom": [
      "packages/*/lib/js/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.2",
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": "7.29.7",
      "basic-ftp@<6.2.1": "6.2.1",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "esbuild": "^0.25.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "follow-redirects@<1.16.2": "1.16.2",
      "immutable@<3.8.4": "3.8.4",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.8",
      "ip-address@<10.7.4": "10.7.4",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@4.17.21": "4.18.0",
      "minimatch@3.1.2": "3.1.5",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@2.3.1": "2.3.2",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "qs@<6.16.1": "6.16.1",
      "react-router@>=6.0.0 <7.18.2": "7.18.2",
      "serialize-javascript@<7.1.3": "7.1.3",
      "shell-quote@<1.9.0": "1.9.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "engine.io@>=4.1.0 <6.6.10": "6.6.10",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.20.1": "8.21.0",
      "zod@<4.6.6": "4.6.6",
      "@babel/core@<7.29.6": "^7.29.7",
      "browser-sync>immutable": "3.8.4",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
