{
  "name": "@truecms/main-nav",
  "version": "3.0.0",
  "description": "Horizontal list of links to key areas on the website. Usually located in the header.",
  "keywords": [
    "auds",
    "sass",
    "scss",
    "css",
    "gov.au",
    "Commonwealth of Australia",
    "design guide",
    "design system"
  ],
  "scripts": {
    "test:a11y": "node ../../scripts/a11y.js",
    "test:helper": "node ../../scripts/helper.js test",
    "test": "npm-run-all --parallel test:*",
    "prepublish": "npm run test:helper",
    "build:pre": "node ../../scripts/helper.js precompile publish",
    "build:js": "node ../../scripts/helper.js compile",
    "build:react": "cd tests/react/ && webpack",
    "build": "npm run build:pre && npm run build:js && npm run build:react",
    "serve": "browser-sync tests --files \"tests/**/*.html, tests/**/*.css, tests/**/*.js\"",
    "watch:js": "onchange \"src/js/*.js\" -- npm run build:js",
    "watch:jsx": "onchange \"src/js/react.js\" \"tests/react/index.js\" -- npm run build",
    "watch:sass": "onchange \"src/sass/*.scss\" \"tests/site/test.scss\" -- npm run build",
    "watch": "npm run build && npm-run-all --parallel serve watch:*"
  },
  "main": "lib/js/react.es5.js",
  "dependencies": {
    "@truecms/animate": "workspace:*",
    "@truecms/core": "workspace:*",
    "@truecms/link-list": "workspace:*"
  },
  "peerDependencies": {
    "@truecms/animate": "^3.0.0",
    "@truecms/core": "^6.0.0",
    "@truecms/link-list": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.0.0",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "files": [
    "lib/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/truecms/design-system-components.git"
  },
  "homepage": "https://design-system-components.truecms.com.au/components/main-nav",
  "bugs": {
    "url": "https://github.com/truecms/design-system-components/issues",
    "email": "engineering@truecms.com.au"
  },
  "author": {
