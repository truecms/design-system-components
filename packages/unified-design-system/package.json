{
  "name": "@truecms/design-system",
  "version": "0.0.0-unified-local",
  "description": "Unified GovAU design system package for Drupal and React consumers.",
  "keywords": [
    "auds",
    "design system",
    "gov.au",
    "unified",
    "drupal",
    "react"
  ],
  "main": "dist/js/components.js",
  "module": "dist/js/components.js",
  "types": "dist/js/components.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/components.d.ts",
      "import": "./dist/js/components.js"
    },
    "./css/govau-theme.css": "./dist/css/govau-theme.css",
    "./css/govau-components.css": "./dist/css/govau-components.css"
  },
  "dependencies": {
    "@truecms/accordion": "workspace:*",
    "@truecms/buttons": "workspace:*",
    "@truecms/header": "workspace:*"
  },
  "peerDependencies": {
    "@truecms/accordion": "^8.0.1",
    "@truecms/buttons": "^4.0.1",
    "@truecms/header": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
